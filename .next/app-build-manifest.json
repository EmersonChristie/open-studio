      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/page.js"
    ],
    "/[tenant]/(dashboard)/layout": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/[tenant]/(dashboard)/layout.js"
    ],
    "/[tenant]/(dashboard)/page": [
      "static/chunks/webpack.js",
