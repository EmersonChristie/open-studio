      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/[tenant]/(dashboard)/apps/page.js"
    ],
    "/[tenant]/(dashboard)/chats/page": [
      "static/chunks/webpack.js",
